# SQLite is used by default for local development — no setup needed.
# For production, point this at a hosted Postgres database (Supabase, Neon, etc.)
# and change the provider in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Random long string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Optional: sign-in codes are logged to the server console when this is unset,
# so you can develop without sending real email. Set this to send real emails
# via https://resend.com (free tier available).
RESEND_API_KEY=""
EMAIL_FROM="Team Portal <onboarding@resend.dev>"
